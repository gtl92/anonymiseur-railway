# Copier en .env et adapter. Ce fichier documente les variables lues par server.js.

PORT=3000

# Dossier tessdata installé par apt (tesseract-ocr-fra). Sur Ubuntu 24.04 :
TESSDATA_PATH=/usr/share/tesseract-ocr/5/tessdata

# Dossier de stockage temporaire des uploads (nettoyé après chaque traitement).
UPLOAD_DIR=./tmp/uploads

# Résolution DPI pour la rasterisation pdftoppm avant OCR.
OCR_DPI=300

# Origines autorisées en cross-origin (CORS), séparées par des virgules.
# Laisser vide en production : le front est servi par ce même serveur
# (même origine), aucune origine externe n'est nécessaire.
ALLOWED_ORIGINS=
